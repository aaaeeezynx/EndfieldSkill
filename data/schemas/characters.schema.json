{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endfieldskill.local/schemas/characters.schema.json",
  "title": "EndfieldSkill characters",
  "type": "object",
  "additionalProperties": false,
  "required": ["characters"],
  "properties": {
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "nameEn", "rarity", "profession", "element", "roles", "tags", "portraitUrl", "skills", "sourceIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "nameEn": { "type": ["string", "null"] },
          "rarity": { "type": ["number", "null"] },
          "profession": { "type": ["string", "null"] },
          "element": { "type": ["string", "null"] },
          "roles": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "portraitUrl": { "type": ["string", "null"] },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "type", "resource", "description", "tags", "triggerConditions", "cooldownSeconds", "energyCost", "sharedSkillPointCost", "sourceIds"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "type": { "enum": ["battle", "combo", "ultimate"] },
                "resource": { "enum": ["shared_skill_points", "energy", "none"] },
                "description": { "type": ["string", "null"] },
                "tags": { "type": "array", "items": { "type": "string" } },
                "triggerConditions": { "type": "array", "items": { "type": "string" } },
                "cooldownSeconds": { "type": ["number", "null"] },
                "energyCost": { "type": ["number", "null"] },
                "sharedSkillPointCost": { "type": ["number", "null"] },
                "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
              }
            }
          },
          "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
