{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endfieldskill.local/schemas/equipment.schema.json",
  "title": "EndfieldSkill equipment",
  "type": "object",
  "additionalProperties": false,
  "required": ["equipment"],
  "properties": {
    "equipment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "slot", "rarity", "setId", "setName", "craftable", "unlock", "unlockDetails", "recommendedFor", "recommendedSourceIds", "roleTags", "elementTags", "stats", "statTypes", "description", "sourceIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "slot": { "enum": ["body", "hand", "edc", null] },
          "rarity": { "type": ["number", "null"] },
          "setId": { "type": ["string", "null"] },
          "setName": { "type": ["string", "null"] },
          "craftable": { "type": "boolean" },
          "unlock": {
            "type": "object",
            "additionalProperties": false,
            "required": ["playerLevel", "playerLevelKind", "chapterId", "chapterOrder", "materials"],
            "properties": {
              "playerLevel": { "type": ["number", "null"] },
              "playerLevelKind": { "const": "equipment_wear_level" },
              "chapterId": { "type": ["string", "null"] },
              "chapterOrder": { "type": ["number", "null"] },
              "materials": { "type": "array", "items": { "type": "string" } }
            }
          },
          "unlockDetails": {
            "type": "object",
            "additionalProperties": false,
            "required": ["formulaId", "recipeTier", "unlockType", "unlockKey", "unlockValue", "authorityRank", "domainId", "domainName"],
            "properties": {
              "formulaId": { "type": ["string", "null"] },
              "recipeTier": { "type": ["string", "number", "null"] },
              "unlockType": { "type": ["number", "null"] },
              "unlockKey": { "type": ["string", "null"] },
              "unlockValue": { "type": ["number", "null"] },
              "authorityRank": { "type": ["number", "null"] },
              "domainId": { "type": ["string", "null"] },
              "domainName": { "type": ["string", "null"] }
            }
          },
          "recommendedFor": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "recommendedSourceIds": { "type": "array", "items": { "type": "string" } },
          "roleTags": { "type": "array", "items": { "type": "string" } },
          "elementTags": { "type": "array", "items": { "type": "string" } },
          "stats": {
            "type": "object",
            "additionalProperties": { "type": ["string", "number"] }
          },
          "statTypes": {
            "type": "object",
            "additionalProperties": { "type": ["string", "null"] }
          },
          "description": { "type": ["string", "null"] },
          "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
